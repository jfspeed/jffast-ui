{
  "name": "jffast-ui",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "疾风（jffast）前端 Base：Vue 3 + TypeScript + Vite + TDesign 的后台管理前端",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfspeed/jffast-ui.git"
  },
  "homepage": "https://github.com/jfspeed/jffast-ui#readme",
  "bugs": {
    "url": "https://github.com/jfspeed/jffast-ui/issues"
  },
  "workspaces": [
    "shared"
  ],
  "scripts": {
    "dev": "vite --open --mode development",
    "dev:linux": "vite --mode development",
    "build:test": "vite build --mode test",
    "build": "vite build --mode release",
    "build:type": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@jfspeed/shared": "file:shared",
    "axios": "^1.20.0",
    "bpmn-js": "18.31.0",
    "dayjs": "^1.11.13",
    "echarts": "^6.1.0",
    "jsencrypt": "^3.5.4",
    "lodash": "^4.17.23",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "tdesign-vue-next": "^1.20.10",
    "vue": "^3.5.18",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.6.1",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@playwright/test": "^1.64.0",
    "@types/lodash": "^4.17.24",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vue/compiler-sfc": "~3.5.18",
    "bpmn-moddle": "10.3.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue-scoped-css": "^3.1.3",
    "globals": "^16.0.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "less": "^4.2.0",
    "lint-staged": "^17.6.0",
    "postcss-html": "^1.6.0",
    "postcss-less": "^7.0.1",
    "prettier": "^3.5.3",
    "stylelint": "~16.16.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-order": "~6.0.4",
    "terser": "^5.43.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.4.5",
    "vite-svg-loader": "^5.1.0",
    "vitest": "^5.0.1",
    "vue-tsc": "3.3.14"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ],
    "*.{css,less,vue}": [
      "stylelint --fix"
    ],
    "*.{js,jsx,ts,tsx,vue,md,json,css,less}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "overrides": {
    "tvision-color": {
      "@babel/runtime-corejs3": "^7.26.10"
    }
  },
  "engines": {
    "node": "^22.22.1 || ^24.0.0 || >=26.0.0"
  }
}

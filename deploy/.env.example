# jffast 前端栈环境变量样例
#
# 用法（.env 准备已脚本化）：
#   bash deploy/init.sh                    # 生成/体检 deploy/.env：公钥自动从并列的
#                                          # jffast 仓读取（同机 clone 时全自动）
#   docker network create jffast-net       # 与后端共享的网络（只需一次）
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d --build
#
# 想手工准备也可以：cp deploy/.env.example deploy/.env 后自己填必填项。
#
# ⚠️ 本文件会包含密钥相关配置，填好后**不要提交进仓库**。

# ── 必填：RSA 公钥 ──
# 必须是与后端 RSA_PRIVATE_KEY 同一对的公钥：
#   bash ../jffast/deploy/gen-rsa.sh      # 一次生成，同时给出前后端两半
# 不成对时服务能正常启动，但登录必失败（密码解密不出来）。
# 前端 release 构建还会校验它非空、且不等于仓库公开的那把示例公钥。
VITE_RSA_PUBLIC_KEY=

# ── 运行时反代目标（nginx 启动时渲染，改它不需要重新 build）──
# compose：后端服务名 + 端口
BACKEND_UPSTREAM=http://backend:7200
# K8s 示例：http://jffast-backend.default.svc.cluster.local:7200
# 必须与后端 server.servlet.context-path=/${app.name}-api 一致
API_PREFIX=/jffast-api
# 上游主机名由 nginx 运行时解析（不是启动即解析），需要指定 DNS：
#   Docker：127.0.0.11（内嵌 DNS，自定义网络下可用）
#   K8s   ：集群 DNS，例如 10.96.0.10（见 pod 内 /etc/resolv.conf）
# 不解析也能起容器：后端缺席时只是接口 502，前端页面照常可访问
RESOLVER=127.0.0.11

# ── 构建期变量（改动需要重新 build 镜像）──
VITE_API_URL=/jffast-api
VITE_BASE_URL=/
VITE_ENABLE_MULTI_TENANT=false

# ── 镜像与端口 ──
# 想用预构建镜像（部署机不装 Node）就改这里，compose 会跳过 build 直接用该 tag
# WEB_IMAGE=ghcr.io/<owner>/jffast-web:latest
WEB_IMAGE=jffast-web:latest
WEB_HOST_PORT=7201

# ── 与后端共享的网络（需先 docker network create jffast-net）──
JFFAST_NETWORK=jffast-net

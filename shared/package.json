{
  "name": "@jfspeed/shared",
  "version": "1.0.0",
  "description": "JFFast 前端公共包：HTTP/CRUD、鉴权指令、i18n、状态管理、图表与工具集，供 jffast-ui 应用复用",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "keywords": [
    "jffast",
    "jfspeed",
    "vue3",
    "tdesign",
    "shared",
    "admin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfspeed/jffast-ui.git",
    "directory": "shared"
  },
  "homepage": "https://github.com/jfspeed/jffast-ui#readme",
  "bugs": {
    "url": "https://github.com/jfspeed/jffast-ui/issues"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./*"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "*.css",
    "*.less",
    "*.vue"
  ],
  "publishConfig": {
    "access": "public"
  },
  "//publishConfig": "本包是 monorepo 内部 workspace 子包，只经由仓库根消费（file:shared）。publishConfig 保留是为了将来真要独立发包时不必改配置；private:true 才是防误发的闸门——scope @jfspeed 若无人持有，别人抢注同名包会造成依赖混淆。",
  "dependencies": {
    "@vueuse/core": "^14.2.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.13",
    "echarts": "^6.1.0",
    "jsencrypt": "^3.5.4",
    "lodash": "^4.17.23",
    "nprogress": "^0.2.0",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qs": "^6.15.0",
    "tdesign-icons-vue-next": "^0.4.4",
    "tdesign-vue-next": "^1.20.10",
    "tvision-color": "^1.6.0",
    "vue": "^3.5.18",
    "vue-i18n": "^9.9.1",
    "vue-router": "^4.6.0"
  }
}

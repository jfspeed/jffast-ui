# 测试环境构建（npm run build:test --mode test）。
# 接口走相对路径 = 同名同源反代口径（nginx 将 /jffast-api 转发到后端）。
# 此前 VITE_API_URL_PREFIX 为死配置（全仓无消费），已清理。
VITE_BASE_URL = /
VITE_IS_REQUEST_PROXY = true
VITE_API_URL = /jffast-api
# 与 .env.development 口径一致：开源版测试构建不启用多租户路由与请求头
# （仓库不再提供 .env.production；npm run build 走 --mode release，读 .env / .env.release）
VITE_ENABLE_MULTI_TENANT = false
VITE_USE_STATIC_ROUTES = false

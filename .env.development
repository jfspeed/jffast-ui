VITE_BASE_URL = /
VITE_IS_REQUEST_PROXY = true
VITE_API_URL = /jffast-api
# 留空：公钥由后端 GET /sys/rsaPublicKey 动态下发（dev/test 启动时自动生成一次性密钥对）。
# 生产构建请注入自有公钥：VITE_RSA_PUBLIC_KEY=<公钥> npm run build
VITE_RSA_PUBLIC_KEY =
VITE_ENABLE_MULTI_TENANT = false
VITE_USE_STATIC_ROUTES = false
VITE_APP_TITLE = 疾风管理系统
VITE_APP_SUBTITLE = jffast —— 极速开发，如风而至

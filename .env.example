# jffast-ui 环境变量示例
# 复制此文件为 .env.development 并修改对应值

# 基础配置
VITE_BASE_URL = /
VITE_IS_REQUEST_PROXY = true
VITE_API_URL = /jffast-api
# dev 代理的后端地址（vite.config.ts 里 VITE_API_URL 前缀转发到这里）
# 单体默认 7200；cloud 形态改成网关端口
VITE_PROXY_TARGET = http://localhost:7200

# 应用信息
VITE_APP_TITLE = 疾风管理系统
VITE_APP_SUBTITLE = jffast —— 极速开发，如风而至

# 多租户（Base 版本默认关闭）
VITE_ENABLE_MULTI_TENANT = false

# 路由模式（false=动态路由，true=静态路由）
# ⚠️ 设为 true 不会跳过鉴权：仍会请求 getUserInfo 校验会话并刷新本地权限缓存，
#    只是「不按后端菜单拼装路由树」。后端必须可达（校验失败会登出），不要把线上站构建成静态路由。
VITE_USE_STATIC_ROUTES = false

# 演示模式横幅（上线演示站构建时设为 true；日常开发保持 false）
VITE_DEMO_MODE = false

# RSA 公钥（用于登录密码加密，与后端 RSA_PRIVATE_KEY 配对）
# 留空时登录直接被阻止（不降级明文传输）；release 构建要求非空，且必须能按
# Base64(X.509 SPKI DER) 解析成合法 RSA 公钥，否则 vite.config.ts 直接中断构建
# 生产构建必须显式注入，否则 vite.config.ts 直接中断：
#   VITE_RSA_PUBLIC_KEY=<公钥> npm run build
# 成对密钥生成：后端 deploy/gen-rsa.sh（前后端必须使用同一对，见后端 README「部署」）
# 留空即可：公钥由后端 GET /sys/rsaPublicKey 动态下发（dev/test 启动时自动生成一次性密钥对，
# 因此仓库里不存任何密钥字面量）。
# 生产环境请注入自有公钥：运行后端 RsaKeyGenerator，或调用 RSAUtil.initKey()
VITE_RSA_PUBLIC_KEY =

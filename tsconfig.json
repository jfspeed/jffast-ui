{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["esnext", "dom"],
    "types": ["vite/client"],
    "noEmit": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/api/core": ["shared/src/api/core"],
      "@/api/core/*": ["shared/src/api/core/*"],
      "@/api/modules": ["src/api/modules"],
      "@/api/modules/*": ["src/api/modules/*"],
      "@/api/system": ["src/api/system"],
      "@/api/codegen": ["src/api/codegen"],
      "@/api": ["src/api"],
      "@/hooks": ["shared/src/hooks"],
      "@/hooks/*": ["shared/src/hooks/*"],
      "@/utils": ["shared/src/utils"],
      "@/utils/*": ["shared/src/utils/*"],
      "@/components": ["shared/src/components"],
      "@/components/*": ["shared/src/components/*"],
      "@/store": ["shared/src/store"],
      "@/store/*": ["shared/src/store/*"],
      "@/layouts": ["shared/src/layouts"],
      "@/layouts/*": ["shared/src/layouts/*"],
      "@/style": ["shared/src/style"],
      "@/locales": ["shared/src/locales"],
      "@/locales/*": ["shared/src/locales/*"],
      "@/config": ["shared/src/config"],
      "@/config/*": ["shared/src/config/*"],
      "@/constants": ["shared/src/constants"],
      "@/constants/*": ["shared/src/constants/*"],
      "@/runtime": ["shared/src/runtime"],
      "@/runtime/*": ["shared/src/runtime/*"],
      "@/types": ["shared/src/types"],
      "@/types/*": ["shared/src/types/*"],
      "@/pages": ["src/pages"],
      "@/pages/*": ["src/pages/*"],
      "@/router": ["src/router"],
      "@/router/*": ["src/router/*"],
      "@/assets": ["src/assets"],
      "@/assets/*": ["src/assets/*"],
      "@jfspeed/shared": ["shared/src"],
      "@jfspeed/shared/*": ["shared/src/*"],
      "@jfspeed/base": ["src/create-app.ts"],
      "@/*": ["src/*"]
    },
    "strict": true
  },
  "include": [
    "**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "shared/**/*.ts",
    "shared/**/*.vue",
    "node_modules/tdesign-vue-next/global.d.ts"
  ],
  "compileOnSave": false
}

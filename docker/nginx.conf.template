# 本文件由 nginx 官方镜像在容器启动时渲染：
#   /etc/nginx/templates/default.conf.template --envsubst--> /etc/nginx/conf.d/default.conf
#
# 会被替换的是 ${BACKEND_UPSTREAM} / ${API_PREFIX} / ${RESOLVER} 三个变量
# （Dockerfile 已给默认值，官方 entrypoint 只替换「已定义的环境变量」，不会留下 ${} 残留）。
# 其余 $uri / $host / $proxy_add_x_forwarded_for 是 nginx 自身变量，不会被 envsubst 触碰。

server {
    listen       80;
    server_name  _;

    # 上游地址用**变量形式 + resolver**，让主机名在运行时才解析。
    # 写成字面量 proxy_pass http://backend:7200 的话，nginx 启动就会解析 backend：
    # 后端没起、不在同一网络、或单独部署前端时 → [emerg] host not found → 容器直接退出，
    # 而不是「先起来、请求时再报 502」。用变量后，后端缺席只是接口 502，前端页面照常可访问。
    #   Docker：127.0.0.11（内嵌 DNS，仅在自定义网络下可用，jffast-net 满足）
    #   K8s   ：填集群 DNS，例如 10.96.0.10（见 pod 内 /etc/resolv.conf）
    resolver ${RESOLVER} valid=30s ipv6=off;
    set $backend_upstream "${BACKEND_UPSTREAM}";

    root /usr/share/nginx/html;
    index index.html;

    # 入口 HTML 不缓存：否则发版后用户拿到的还是旧 index.html，
    # 而它引用的旧 hash 资源已被清理 → 白屏
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # 带 hash 的构建产物可长期缓存
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # 前端是 createWebHistory：刷新 /xxx 子页面时磁盘上没有对应文件，
    # 必须回退到 index.html，否则直接 404
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端 API：前缀必须与后端 server.servlet.context-path 一致（默认 /jffast-api）
    # $uri 会带上 rewrite 之后的路径，$is_args$args 保住 query string
    # （proxy_pass 用变量时 nginx 不再自动拼 URI，必须显式写全）
    #
    # ^~ 不能省：nginx 的正则 location（上面缓存静态资源那条）优先级高于普通前缀匹配，
    # 没有 ^~ 时 /jffast-api/xxx.css 这类路径会被当成静态文件走 try_files → 404
    location ^~ ${API_PREFIX}/ {
        proxy_pass $backend_upstream$uri$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket（站内通知）：升级头映射见 conf.d/00-ws-map.conf
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # 本地文件存储访问：后端实际提供的是 ${API_PREFIX}/upload/**，
    # 而前端拿到的是 /upload/**（jffast.file.storage.local.access-path=/upload），
    # 这里做一次前缀改写，口径与 vite dev 的 /upload 代理规则保持一致。
    # 若已改成 minio / OSS / COS 直传，本段不会被命中。
    location ^~ /upload/ {
        rewrite ^/upload/(.*)$ ${API_PREFIX}/upload/$1 break;
        proxy_pass $backend_upstream$uri$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
